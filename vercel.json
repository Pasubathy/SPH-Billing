{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend-react/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js"
    },
    {
      "src": "^/(assets|Images|Icons)/(.*)",
      "dest": "/frontend-react/$1/$2"
    },
    {
      "src": "^/(.*\\.(svg|png|ico|txt))$",
      "dest": "/frontend-react/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend-react/index.html"
    }
  ]
}
