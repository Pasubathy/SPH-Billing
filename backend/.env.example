# SPH Billing — Backend Environment Configuration Template
# Copy this file to .env and fill in your values

# 1. PostgreSQL Database URL (Neon / Supabase / Local PostgreSQL)
# For Dev: use Neon dev branch / pooler URL
# For Prod: use Neon main branch / pooler URL
DATABASE_URL=postgresql://user:password@ep-host-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Admin Authentication
ADMIN_USERNAME=SPH.admin
ADMIN_PASSWORD_HASH=$2b$10$STozCKms6oSvtsgQXQ286uviJxX0kOlb4GwLaSJbWh/mCWm8QGSgW

# 3. Google Gemini AI API Key (for automated invoice OCR & data extraction)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 4. Security & CORS Configuration
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://sph-billing.vercel.app

# 5. Environment Mode ('development' or 'production')
NODE_ENV=development
